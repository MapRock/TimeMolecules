#################################################################
# Additional ontology classes for premature departure
#################################################################

tm:ExceptionEvent
    a owl:Class ;
    rdfs:subClassOf tm:Event ;
    rdfs:label "Exception event" ;
    rdfs:comment "An event that represents a deviation, interruption, or undesired path in a process." .

tm:AbandonmentEvent
    a owl:Class ;
    rdfs:subClassOf tm:ExceptionEvent ;
    rdfs:label "Abandonment event" ;
    rdfs:comment "An event where the participant exits the process before completing an expected goal." .

tm:DepartureBeforeOrderingEvent
    a owl:Class ;
    rdfs:subClassOf tm:AbandonmentEvent ;
    rdfs:subClassOf tm:RestaurantEvent ;
    rdfs:label "Departure before ordering event" ;
    rdfs:comment "A restaurant event where the customer leaves before placing an order." .

tm:RiskReason
    a owl:Class ;
    rdfs:label "Risk reason" ;
    rdfs:comment "A possible reason, condition, or contributing factor associated with an undesirable event." .

tm:hasRiskReason
    a owl:ObjectProperty ;
    rdfs:domain tm:Event ;
    rdfs:range tm:RiskReason ;
    rdfs:label "has risk reason" ;
    rdfs:comment "Connects an event to possible reasons that may explain or contribute to that event." .

tm:increasesRiskOf
    a owl:ObjectProperty ;
    rdfs:label "increases risk of" ;
    rdfs:comment "Indicates that a condition, concept, or earlier event may increase the likelihood of another event." .

tm:preventsExpectedEvent
    a owl:ObjectProperty ;
    rdfs:domain tm:Event ;
    rdfs:range tm:Event ;
    rdfs:label "prevents expected event" ;
    rdfs:comment "Indicates that an event interrupts the normal process before an expected later event occurs." .

tm:negativeOutcome
    a owl:DatatypeProperty ;
    rdfs:domain tm:Event ;
    rdfs:range xsd:boolean ;
    rdfs:label "negative outcome" .

#################################################################
# Additional restaurant event: order
#################################################################

tm:OrderingEvent
    a owl:Class ;
    rdfs:subClassOf tm:RestaurantEvent ;
    rdfs:label "Ordering event" .

rest:Ordered
    a tm:OrderingEvent ;
    rdfs:label "ordered" ;
    skos:prefLabel "ordered" ;
    rdfs:comment "The customer places an order." ;
    tm:hasProcessRole rest:OrderCommitment .

rest:OrderCommitment
    a skos:Concept ;
    skos:prefLabel "Order commitment" ;
    skos:definition "The point where the customer has committed to buying food or service from the restaurant." .

#################################################################
# New premature departure event
#################################################################

rest:DepartedBeforeOrdering
    a tm:DepartureBeforeOrderingEvent ;
    rdfs:label "departed before ordering" ;
    skos:prefLabel "departed before ordering" ;
    rdfs:comment "The customer leaves the restaurant before placing an order." ;
    tm:negativeOutcome true ;
    tm:preventsExpectedEvent rest:Ordered ;
    tm:affects rest:RevenueOpportunity ;
    tm:affects rest:CustomerSatisfaction ;
    tm:affects rest:WaitingExperience ;
    tm:hasRiskReason rest:ExcessiveWaitTime ;
    tm:hasRiskReason rest:UnpleasantGreeting ;
    tm:hasRiskReason rest:TooCrowded ;
    tm:hasRiskReason rest:UnappealingSpecials ;
    tm:hasRiskReason rest:HostUnavailable ;
    tm:hasRiskReason rest:ConfusingSeatingProcess .

#################################################################
# Risk reasons
#################################################################

rest:ExcessiveWaitTime
    a tm:RiskReason ;
    a skos:Concept ;
    skos:prefLabel "Excessive wait time" ;
    skos:definition "The customer waits longer than expected or longer than they are willing to tolerate." ;
    tm:increasesRiskOf rest:DepartedBeforeOrdering ;
    skos:broader rest:WaitingExperience .

rest:UnpleasantGreeting
    a tm:RiskReason ;
    a skos:Concept ;
    skos:prefLabel "Unpleasant greeting" ;
    skos:definition "The customer is acknowledged in a way that feels rude, indifferent, rushed, or unwelcoming." ;
    tm:increasesRiskOf rest:DepartedBeforeOrdering ;
    skos:broader rest:ServiceEngagement .

rest:TooCrowded
    a tm:RiskReason ;
    a skos:Concept ;
    skos:prefLabel "Too crowded" ;
    skos:definition "The restaurant appears too full, noisy, cramped, or uncomfortable for the customer." ;
    tm:increasesRiskOf rest:DepartedBeforeOrdering ;
    skos:broader rest:RestaurantEnvironment .

rest:UnappealingSpecials
    a tm:RiskReason ;
    a skos:Concept ;
    skos:prefLabel "Unappealing specials" ;
    skos:definition "The customer does not find the promoted menu items, specials, or visible offerings attractive enough to stay." ;
    tm:increasesRiskOf rest:DepartedBeforeOrdering ;
    skos:broader rest:MenuAppeal .

rest:HostUnavailable
    a tm:RiskReason ;
    a skos:Concept ;
    skos:prefLabel "Host unavailable" ;
    skos:definition "No host, employee, kiosk, or other service mechanism is available to acknowledge or seat the customer." ;
    tm:increasesRiskOf rest:DepartedBeforeOrdering ;
    skos:broader rest:ServiceEngagement .

rest:ConfusingSeatingProcess
    a tm:RiskReason ;
    a skos:Concept ;
    skos:prefLabel "Confusing seating process" ;
    skos:definition "The customer is unsure whether to wait, seat themselves, check in, scan a code, or speak to an employee." ;
    tm:increasesRiskOf rest:DepartedBeforeOrdering ;
    skos:broader rest:ServiceEngagement .

#################################################################
# Broader semantic concepts affected by premature departure
#################################################################

rest:RevenueOpportunity
    a skos:Concept ;
    skos:prefLabel "Revenue opportunity" ;
    skos:definition "The potential sale associated with a customer visit." .

rest:CustomerSatisfaction
    a skos:Concept ;
    skos:prefLabel "Customer satisfaction" ;
    skos:definition "The customer's perceived quality of the restaurant experience." .

rest:RestaurantEnvironment
    a skos:Concept ;
    skos:prefLabel "Restaurant environment" ;
    skos:definition "The physical, social, and sensory conditions of the restaurant, such as crowding, noise, seating, and comfort." .

rest:MenuAppeal
    a skos:Concept ;
    skos:prefLabel "Menu appeal" ;
    skos:definition "The attractiveness of the available food, specials, prices, and visible offerings." .

#################################################################
# Process links
#################################################################

rest:RestaurantVisitProcess
    tm:hasEvent rest:DepartedBeforeOrdering ;
    tm:hasEvent rest:Ordered .

rest:Arrive
    tm:usuallyFollowedBy rest:Greeted ;
    tm:usuallyFollowedBy rest:DepartedBeforeOrdering .

rest:Greeted
    tm:usuallyFollowedBy rest:Ordered ;
    tm:usuallyFollowedBy rest:DepartedBeforeOrdering .

#################################################################
# Markov-style transition annotations
#################################################################

rest:ArriveToDepartedBeforeOrderingTransition
    a tm:EventTransition ;
    rdfs:label "arrive to departed before ordering transition" ;
    tm:fromEvent rest:Arrive ;
    tm:toEvent rest:DepartedBeforeOrdering ;
    tm:probability "0.06"^^xsd:decimal ;
    tm:averageElapsedSeconds "240.0"^^xsd:decimal ;
    tm:standardDeviationSeconds "95.0"^^xsd:decimal ;
    rdfs:comment "In this model slice, some customers arrive and then leave before ordering, often after a delay or negative early-service condition." .

rest:GreetedToDepartedBeforeOrderingTransition
    a tm:EventTransition ;
    rdfs:label "greeted to departed before ordering transition" ;
    tm:fromEvent rest:Greeted ;
    tm:toEvent rest:DepartedBeforeOrdering ;
    tm:probability "0.04"^^xsd:decimal ;
    tm:averageElapsedSeconds "180.0"^^xsd:decimal ;
    tm:standardDeviationSeconds "80.0"^^xsd:decimal ;
    rdfs:comment "In this model slice, some customers are greeted but still leave before ordering, suggesting that acknowledgment alone may not be enough to retain them." .
